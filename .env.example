# ==============================================================
# Asociación Cultural Totora — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# ==============================================================

# --- Firebase Admin SDK (usar UNA de las tres opciones) -------
# Opción 1: JSON completo de la cuenta de servicio en una sola línea
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción 2: El mismo JSON codificado en Base64 (recomendado en hosting)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opción 3: Ruta al archivo descargado desde
# https://console.firebase.google.com/project/totora-7df04/settings/serviceaccounts/adminsdk
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

FIREBASE_PROJECT_ID=totora-7df04
FIREBASE_STORAGE_BUCKET=totora-7df04.firebasestorage.app

# --- Firebase Client SDK (público, se expone al navegador) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=totora-7df04.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=totora-7df04
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=totora-7df04.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Facebook (para scripts y Cloud Functions) -----------------
FACEBOOK_PAGE_ID=100063306752926
FACEBOOK_PAGE_ACCESS_TOKEN=
# Token secreto que inventas tú; se usa para verificar el webhook de Meta
FACEBOOK_VERIFY_TOKEN=cambia-este-token-totora
FACEBOOK_APP_SECRET=
